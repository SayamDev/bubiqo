{
  "name": "bubiqo",
  "version": "0.1.0",
  "private": true,
  "description": "An action layer for the web.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "demo": "python3 -m http.server 8123 --directory fixtures",
    "icons": "python3 tools/make-icons.py",
    "prove:reminders": "vitest run tests/reminders.test.ts --reporter=basic",
    "capture-snippet": "node tools/make-capture-snippet.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
